# Required: Your Discord Bot Token
BOT_TOKEN=

# Optional: Path to the SQLite database file
# Defaults to ./data/bountyhunter.db
DATABASE_PATH=./data/bountyhunter.db

# Optional: How often to check for new posts (in minutes)
# Defaults to 30
POLL_INTERVAL=30

# Optional: Discord User ID for admin commands (!force_free) and error DMs
ADMIN_DISCORD_ID=

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Defaults to INFO
LOG_LEVEL=INFO

# Optional: IsThereAnyDeal API Key
ITAD_API_KEY=

# Optional: Which free-game content to announce, comma separated.
# Options: game, dlc, item, beta (aliases: games, dlcs, addons, expansions, items, loot,
# playtest). Defaults to game: GamerPower returns roughly three DLC or item giveaways for
# every game, and a scan that announces all of them floods the channel.
# e.g. FREE_GAMES_CONTENT_TYPES=game,dlc
FREE_GAMES_CONTENT_TYPES=game
